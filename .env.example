# ============================================================================
# Telangana Sale Deed Wizard — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your real values.
#   cp .env.example .env.local
# NEVER commit .env.local — it is git-ignored for security.
# ============================================================================

# REQUIRED. Your Google Gemini API key.
# Get one free at: https://aistudio.google.com/apikey
# The app runs in a degraded "heuristic simulation" mode if this is missing,
# so the UI still works, but no real AI extraction/verification happens.
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL. Port the server listens on. Defaults to 3000.
# Most hosts (Render, Cloud Run, Railway, Fly.io) inject their own PORT — leave unset there.
# PORT=3000

# OPTIONAL. Set to "production" to serve the pre-built ./dist bundle instead of
# running the Vite dev middleware. Deployment platforms should set this.
# NODE_ENV=production
