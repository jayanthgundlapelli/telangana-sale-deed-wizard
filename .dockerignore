# Keep the Docker build context small and secret-free.
node_modules
dist
server.js
*.log
npm-debug.log

# Secrets — must never enter the image
.env
.env.local
.env.*.local

# VCS / editor / OS
.git
.gitignore
.vscode
.idea
.DS_Store

# Docs & session notes (not needed at runtime)
*.md
START_HERE.txt

# Test & scratch artifacts
Samples/
.agents/
.playwright-mcp/
test-*.ts
test-*.mjs
*-check.png
step*.png
bun.lock

# NOTE: templates/*.docx are intentionally NOT ignored — they ship in the image.
